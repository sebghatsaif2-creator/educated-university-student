{
  "name": "kunduz-certificate-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Kunduz University Offline Certificate Request and Printing System",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed/seed.js",
    "seed:reset": "node src/seed/seed.js --reset",
    "generate:samples": "node src/scripts/generateSamplePdfs.js",
    "test": "node --test --test-concurrency=1 tests/textGenerator.test.js tests/workflow.test.js tests/certificatePdf.test.js tests/offlineFullFlow.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "puppeteer": "^25.18.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.3.2"
  }
}
