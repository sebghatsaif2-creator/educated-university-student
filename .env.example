# ==============================================================================
# Kunduz University — Certificate Request & Printing System (Offline LAN)
# Copy this file to `.env` in the repository root and update secrets for production.
# ==============================================================================

# Environment: development | production | test
NODE_ENV=development

# Express server binding (0.0.0.0 enables access from local LAN workstations)
HOST=0.0.0.0
PORT=5000

# Local MongoDB connection string (100% offline, no cloud dependency)
MONGODB_URI=mongodb://127.0.0.1:27017/kunduz_certificates

# JWT authentication (MUST replace JWT_SECRET with a long random string in production)
JWT_SECRET=change-this-to-a-strong-offline-secret-min-32-chars
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Allowed CORS origins (comma-separated, leave `*` or local LAN URLs in development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local network (LAN) base URL encoded into certificate QR codes (points to /verify/:serial)
LAN_BASE_URL=http://192.168.1.10:5000

# Optional path to local offline Chrome/Chromium binary for Puppeteer PDF rendering.
# Leave blank to auto-detect ./offline/chromium, Puppeteer cache, or local OS Chromium:
#   Linux:   /usr/bin/chromium  (or /usr/local/bin/chromium)
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=

# Daily MongoDB backup settings (used by `npm run backup` / `scripts/backup-db.sh`)
BACKUP_DIR=./backups
BACKUP_KEEP_COUNT=14

# Trust reverse proxy (set to 1 if running behind local Nginx on LAN)
TRUST_PROXY=0

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15

# Default seed credentials (used only by `npm run seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=مدیر سیستم پوهنتون کندز
SEED_OFFICER_USERNAME=officer
SEED_OFFICER_PASSWORD=Officer@12345
SEED_OFFICER_NAME=کارمند مدیریت عمومی محصلان
